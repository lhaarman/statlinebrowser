{
  "name": "statlinebrowser",
  "displayName": "StatlineBrowser",
  "description": "Uses opendata API to provide table previews in VSC",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "statlineBrowserActivityBar",
          "title": "Statline Browser",
          "icon": "assets/mainPanelIcon.svg"
        }
      ]
    },
    "views": {
      "statlineBrowserActivityBar": [
        {
          "id": "mainPanel",
          "name": "Main view panel of statlinebrowser",
          "type": "webview",
          "icon": "assets/mainPanelIcon.svg"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.125.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
